<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="#F8FAFD"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fillViewport="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/appBar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </HorizontalScrollView>

            <ImageButton
                android:id="@+id/closeApp"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Close app"
                android:padding="18dp"
                android:scaleType="center"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </LinearLayout>

        <com.herewhite.sdk.WhiteboardView
            android:id="@+id/white"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="118dp"
            android:background="#EAF2FF"
            android:orientation="vertical"
            android:padding="8dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/previewBar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/boxNormal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Normal"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/boxMax"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Max"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/boxMin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Min"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/addSlideApp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Slide"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/prevPage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prev"
                    android:textAllCaps="false" />

                <TextView
                    android:id="@+id/pageState"
                    android:layout_width="96dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="0/0"
                    android:textColor="#27364A"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/nextPage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/logDisplay"
        android:layout_width="240dp"
        android:layout_height="130dp"
        android:layout_gravity="end|center_vertical"
        android:background="#CCFFFFFF"
        android:padding="8dp"
        android:textColor="#27364A"
        android:textSize="12sp" />
</FrameLayout>
